# PostgreSQL runs in Docker and is published only on localhost.
POSTGRES_DB=home_ai
POSTGRES_USER=home_ai
POSTGRES_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Ollama runs natively on Windows.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false

# Application safety and calendar behavior
ENABLE_GUARD=true
ALLOW_PROMPT_OVERRIDE=false
EVENT_TIMEZONE=Europe/London

# Document retrieval (local embedding model, independent of the chat model)
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
# Default storage is <project>/storage/documents. Set an absolute path if overriding.
# DOCUMENT_STORAGE_DIR=C:/path/to/home-ai-documents
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=200
DOCUMENT_MAX_CHARS=1000000
RAG_MAX_DISTANCE=0.65
RAG_CONTEXT_CHARS=12000
